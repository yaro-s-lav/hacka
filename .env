# RTP address reachable from training workstations, normally the server LAN IP.
SIP_PUBLIC_ADDRESS=172.16.60.98
TURN_SECRET=replace-with-long-random-turn-secret
# Mount an external/remote backup destination here in the deployed contour.
BACKUP_DIR=./backups
