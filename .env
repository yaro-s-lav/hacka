# Учебные значения. Перед доступом из сети замените пароли и секреты.
POSTGRES_DB=arm112
POSTGRES_USER=arm112
POSTGRES_PASSWORD=change_me_now
SECRET_KEY=replace-with-long-random-secret
ADMIN_PASSWORD=admin12345
TEACHER_PASSWORD=teacher12345
STUDENT_PASSWORD=student12345
AI_MODE=rules
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
VOICE_ENGINE=silero
# Set ARM_HOST to the actual server name/IP for HTTPS browser telephony.
ARM_HOST=localhost
