# Учебные значения. Перед доступом из сети замените пароли и секреты.
POSTGRES_DB=arm112
POSTGRES_USER=arm112
POSTGRES_PASSWORD=change_me_now
SECRET_KEY=replace-with-long-random-secret
ADMIN_PASSWORD=admin12345
TEACHER_PASSWORD=teacher12345
STUDENT_PASSWORD=student12345
AI_MODE=rules
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
VOICE_ENGINE=piper
# Set ARM_HOST to the actual server name/IP for HTTPS browser telephony.
ARM_HOST=localhost
ASTERISK_AMI_SECRET=replace-with-long-random-ami-secret
# RTP address reachable from training workstations, normally the server LAN IP.
SIP_PUBLIC_ADDRESS=127.0.0.1
TURN_SECRET=replace-with-long-random-turn-secret
# Mount an external/remote backup destination here in the deployed contour.
BACKUP_DIR=./backups
# 1..23 hours; maximum keeps copies more frequent than once a day.
BACKUP_INTERVAL_HOURS=23

# Explicit active classifier; other XLSX files can remain in source_materials.
CLASSIFIER_FILE=Классификатор_происшествий_v_046_24_корректировка_МВД_+_Департамент.xlsx
